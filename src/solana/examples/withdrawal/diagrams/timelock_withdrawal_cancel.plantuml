@startuml "Timelock withdrawal cancellation"

!pragma teoz true

' Lines style
skinparam linetype ortho
skinparam defaultFontColor black
' Define the sequence's style
skinparam SequenceArrowColor black
' Define the actor's style
skinparam Actor {
    BackgroundColor white
    BorderColor black
    Padding 15
}
' Define the box's style
skinparam SequenceBox {
  BackgroundColor LightBlue
  BorderColor black
  FontSize 21
  Padding 20
}
' Define the participant's style
skinparam SequenceParticipant {
    ArrowColor black
    BackgroundColor white
    BorderColor black
    Padding 15
}
' Define the life line's style
skinparam SequenceLifeLine {
    BackgroundColor LightGray
    BorderColor black
}

title Timelock Withdrawal, Manual Cancellation

actor "Collateral Admin / Owner" as Admin

box "Solana Network"
participant "Solana RPC" as RPC
participant "Collateral Program" as Program
participant "Withdrawal Request" as Request
end box

activate Admin
Admin -> RPC ++: Request a permissionless withdrawal
RPC -> Program ++: request_permissionless_withdrawal
Program -> Request ++: Create WithdrawalRequest\n(executable_from = now + 7 days)
Admin <-- RPC --: Return tx
deactivate Program

Admin -> Admin : Decide to cancel\n(any time, before or after the timelock)

Admin -> RPC ++: cancel_permissionless_withdrawal (no reason)
RPC -> Program ++: Verify sender is a current admin/owner\nand no reason is attached
Program -> Request : Close request, rent to rent collector
deactivate Request
RPC <-- Program --: TimelockWithdrawalAdminCancelled
Admin <-- RPC --: Return tx
deactivate Admin

note over Program
  Rain executors may also cancel a pending request at any
  time, with a mandatory reason. Cancellations and reasons
  are visible via GET /v1/issuing/time-lock-withdrawals.
end note

@enduml
